{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Contract Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required_columns", "optional_columns"],
        "properties": {
          "required_columns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "optional_columns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
