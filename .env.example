# API authentication
API_KEY_REQUIRED=true
RECONCILIATION_API_KEY=replace-with-a-long-random-secret

# Production persistence
DATABASE_URL=postgresql://reconciliation:reconciliation@localhost:5432/reconciliation
# Leave DATABASE_URL empty to use the local SQLite fallback.
RECONCILIATION_DB=data/reconciliation.db

# AI escalation
AI_PROVIDER=none
AI_MODEL=gpt-5.6-luna
AI_TIMEOUT_SECONDS=20
OPENAI_API_KEY=


# Object storage
# local is for development; use s3 with S3_BUCKET in production.
OBJECT_STORE=local
OBJECT_STORE_PATH=data/objects
S3_BUCKET=
S3_PREFIX=reconciliation

# Tenant authorization (key-to-tenant mapping)
# Format: tenant_id:api_key,tenant_id_2:api_key_2
TENANT_API_KEYS=

# Distributed jobs and abuse protection
JOB_QUEUE=background
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=30
# Use redis in multi-replica/production deployments; memory is for local tests only.
RATE_LIMIT_BACKEND=redis

# Audit log (local fallback; production should use durable centralized storage)
AUDIT_LOG_PATH=data/audit/events.jsonl
