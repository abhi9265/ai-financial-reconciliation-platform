# API security
API_KEY_REQUIRED=true
RECONCILIATION_API_KEY=replace-with-a-long-random-secret

# Persistence
RECONCILIATION_DB=data/reconciliation.db

# AI escalation
AI_PROVIDER=none
AI_MODEL=gpt-5.6-luna
AI_TIMEOUT_SECONDS=20

# Set AI_PROVIDER=openai and provide an OpenAI API key only in the runtime environment.
# OPENAI_API_KEY=your-openai-api-key
