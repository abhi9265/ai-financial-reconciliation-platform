{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Financial Transaction",
  "description": "Canonical contract for normalized financial records entering reconciliation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["transaction_id","source_system","source_record_id","transaction_date","amount","currency","transaction_type","ingestion_batch_id","record_hash","ingested_at"],
  "properties": {
    "transaction_id":{"type":"string"},
    "source_system":{"type":"string","enum":["bank","purchase_register","sales_register","tally","invoice","gst"]},
    "source_record_id":{"type":"string"},
    "transaction_date":{"type":"string","format":"date"},
    "value_date":{"type":["string","null"],"format":"date"},
    "transaction_type":{"type":"string","enum":["DEBIT","CREDIT","PURCHASE","SALE","RECEIPT","PAYMENT","OTHER"]},
    "amount":{"type":"number","exclusiveMinimum":0},
    "debit":{"type":["number","null"],"minimum":0},
    "credit":{"type":["number","null"],"minimum":0},
    "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
    "description":{"type":["string","null"]},
    "reference_number":{"type":["string","null"]},
    "vendor_name":{"type":["string","null"]},
    "vendor_gstin":{"type":["string","null"],"pattern":"^[0-9A-Z]{15}$"},
    "invoice_number":{"type":["string","null"]},
    "invoice_date":{"type":["string","null"],"format":"date"},
    "taxable_amount":{"type":["number","null"],"minimum":0},
    "cgst":{"type":["number","null"],"minimum":0},
    "sgst":{"type":["number","null"],"minimum":0},
    "igst":{"type":["number","null"],"minimum":0},
    "total_tax":{"type":["number","null"],"minimum":0},
    "account_name":{"type":["string","null"]},
    "bank_account":{"type":["string","null"]},
    "source_file":{"type":["string","null"]},
    "source_row_number":{"type":["integer","null"],"minimum":1},
    "record_hash":{"type":"string","minLength":16},
    "ingestion_batch_id":{"type":"string","minLength":1},
    "ingested_at":{"type":"string","format":"date-time"}
  }
}